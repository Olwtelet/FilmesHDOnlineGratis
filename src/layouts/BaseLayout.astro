---
// Documento comum a todas as páginas: head com metadados do site, runtime original (webflow.css, main.css, out.css,
// app.js), o invólucro do Taxi.js, o canvas do WebGL e os scripts locais.
import RotateNotice from '../components/RotateNotice.astro';
import SessoesOrdem from '../components/SessoesOrdem.astro';
import { SITE } from '../data/site';

interface Props {
  /** título da página; o nome do site é acrescentado quando cabe */
  title: string;
  description?: string;
  /** caminho da imagem de compartilhamento, 1200x630 */
  ogImage?: string;
  ogImageAlt?: string;
  /** dados estruturados (JSON-LD) */
  jsonLd?: object | object[];
  noindex?: boolean;
  /** onde fica o aviso de girar o aparelho no <body> */
  rotate?: 'before' | 'after' | 'none';
  /** chunk do Webflow; /programacao usa o que traz o módulo de lightbox */
  webflowScript?: string;
}

const {
  title,
  description = SITE.description,
  ogImage = '/og/padrao.jpg',
  ogImageAlt = `Símbolo de ${SITE.name}`,
  jsonLd,
  noindex = false,
  rotate = 'after',
  webflowScript = '/assets/js/webflow.js',
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site).href;
const imagem = new URL(ogImage, site).href;
const tituloCompleto = title === SITE.name ? title : `${title} · ${SITE.name}`;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <title>{tituloCompleto}</title>
    <meta content={description} name="description" />
    <meta content={SITE.author} name="author" />
    <meta content="#000000" name="theme-color" />
    {noindex && <meta content="noindex" name="robots" />}
    {!noindex && <link href={canonical} rel="canonical" />}
    <meta content={tituloCompleto} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={imagem} property="og:image" />
    <meta content={ogImageAlt} property="og:image:alt" />
    <meta content="1200" property="og:image:width" />
    <meta content="630" property="og:image:height" />
    {!noindex && <meta content={canonical} property="og:url" />}
    <meta content={SITE.name} property="og:site_name" />
    <meta content="pt_BR" property="og:locale" />
    <meta content="website" property="og:type" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={tituloCompleto} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={imagem} name="twitter:image" />
    {/* minimum-scale: sem ele, em tablet o Chrome alarga a janela de layout até caber o carrossel e o canvas vai junto */}
    <meta content="width=device-width, initial-scale=1, minimum-scale=1" name="viewport" />
    {/* Antes de os CSS chegarem, em rede lenta: sem isto o primeiro quadro é branco */}
    <style is:inline>html{background:#000}</style>
    <link href="/rss.xml" rel="alternate" title={`Programação de ${SITE.name}`} type="application/rss+xml" />
    <link href="/assets/css/webflow.css" rel="stylesheet" type="text/css" />
    <script is:inline type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/assets/img/site/favicon-32.png" rel="icon" type="image/png" />
    <link href="/assets/img/site/icone-toque-180.png" rel="apple-touch-icon" />
    <script is:inline>
      history.scrollRestoration = "manual";
    </script>
    <link rel="stylesheet" href="/assets/css/out.css" />
    <link rel="preload" href="/assets/fonts/tema/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/assets/fonts/tema/jetbrains-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    <slot name="head-local" />
    <script is:inline defer src="/assets/js/local-imagens.js"></script>
    <script is:inline defer src="/assets/js/app.js"></script>
  </head><body>
    <div class="w-embed"><link rel="stylesheet" href="/assets/css/main.css" /></div><link rel="stylesheet" href="/assets/css/tema-sinal.css" />
    {rotate === 'before' && <RotateNotice />}
    <div data-taxi="" class="w"><slot /></div>
    <div data-gl="c" class="canvas"></div>
    <SessoesOrdem />
    {rotate === 'after' && <RotateNotice />}
    <slot name="after" />
    <script is:inline src="/assets/js/jquery-3.5.1.min.js" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
    <script is:inline src="/assets/js/webflow.schunk.js" type="text/javascript"></script>
    <script is:inline src={webflowScript} type="text/javascript"></script>
    <script is:inline src="/assets/js/local-menu.js"></script>
    <script is:inline src="/assets/js/local-trailer.js"></script>
  </body>
</html>
