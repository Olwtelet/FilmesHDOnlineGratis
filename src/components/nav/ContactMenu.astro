---
// Cartão de contato do menu em /contato/: chamada e botão de e-mail.
import DownArrowButton from '../ui/DownArrowButton.astro';
import { EMAIL } from '../../data/site';
---

<div class="contact-menu-w c-menu">
  <div class="svg-nav-alt-w c-menu">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 34 26" width="100%" class="svg c-menu">
      <path fill="currentColor" d="M17.3 17.572c11.028-2.873 14.873-9.916 15.72-14.768.262-1.5-1.01-2.696-2.533-2.696.882 7.342-7.174 13.21-13.758 14.895a.754.754 0 0 1-.35.007C9.86 13.602 2.01 6.18 3 .108 1.352.108-.018 1.458.295 3.076c1.666 8.613 10.387 13.086 15.526 14.494.483.133.994.128 1.479.002Z"></path>
      <path fill="currentColor" fill-rule="evenodd" d="M2.453 2.453v21.041h28.322V2.454H2.453ZM1.484 0C.664 0 0 .664 0 1.484v22.98c0 .82.664 1.484 1.484 1.484h30.26c.82 0 1.484-.665 1.484-1.484V1.484c0-.82-.664-1.484-1.484-1.484H1.484Z" clip-rule="evenodd"></path>
    </svg>
  </div>
  <div class="nav-alt-text-w">
    <div class="nav-alt-tx">FALE CONOSCO</div>
    <a href={`mailto:${EMAIL.main}`} class="c-menu-cta-w w-inline-block">
      <div class="c-menu-cta-tx">E-MAIL</div>
      <DownArrowButton class="red c-menu" svgClass="xs to-r" />
    </a>
  </div>
</div>
