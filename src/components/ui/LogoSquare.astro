---
/**
 * Símbolo da marca (span.logo-footer): no rodapé e, com a classe extra "mb-0", no herói da página Sobre. É o "A" colorido de
 * reference/brand/logo.jpg, com fundo externo transparente e halo escuro, na mesma caixa do antigo quadrado (bloco 7d do tema).
 */
interface Props {
  /** classe extra depois de logo-footer */
  class?: string;
}
const { class: extra } = Astro.props;
---

<span class={extra ? `logo-footer marca-simbolo ${extra}` : 'logo-footer marca-simbolo'} role="img" aria-label="Filmes HD Online Grátis"></span>
