---
/**
 * Round arrow icon used all over the site: `figure.down-arrow-btn > svg.svg` (same two paths
 * everywhere; direction/colour/size come from classes).
 *
 * Props
 *   class     modifiers appended after "down-arrow-btn", in the original order
 *   svgClass  modifiers appended after "svg"
 *
 * Occurrences in the original site:
 *   nav "EMAIL US" (every page)       class="red c-menu"            svgClass="xs to-r"
 *   footer newsletter + sitemap       class="right black smaller"   svgClass="smaller"
 *     (footer variant on-black appends w-variant-ff3af7bd-5bdd-e152-9111-9fa617f1f874 to class)
 *   /about hero                       (no modifiers)
 *   /films/* hero "All Work" back     class="left"
 *   /films/* hero scroll arrow        class="black"
 *   /films/* director's cut           class="tr smaller bump-up"    svgClass="smallest"
 *   /films/* reviews prev / next      class="left" / class="right"
 *   /films/* next project CTA         class="right black smaller"   svgClass="smaller"
 *   /films/* previous/next list (9x)  class="right black-copy smaller" svgClass="smaller"
 */
interface Props {
  class?: string;
  svgClass?: string;
}
const { class: cls, svgClass } = Astro.props;
---

<figure class={cls ? `down-arrow-btn ${cls}` : 'down-arrow-btn'}>
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 100 100" width="100%" class={svgClass ? `svg ${svgClass}` : 'svg'}>
    <path
      fill="currentColor"
      d="M69.022 85.363c16.693-13.32 20.658-33.261 20.16-43.736H77.95c0 17.454-11.106 29.106-20.543 35.517-4.676 3.177-10.818 2.998-15.414-.293-17.124-12.264-19.958-27.753-18.988-35.224H10.305c0 20.438 9.697 34.444 20.244 43.16 11.033 9.118 27.285 9.503 38.473.576Z"
    ></path>
    <path fill="currentColor" fill-rule="evenodd" d="M56.016 5v79.243H43.56V5h12.455Z" clip-rule="evenodd"></path>
  </svg>
</figure>
