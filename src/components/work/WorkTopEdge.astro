---
/**
 * Topo de /programacao/: a chave CENAS / CARTAZ (div.work-edge.top). O app.js troca o modo do carrossel por
 * data-work="toggle" / "toggleWrapper" e faz o fade dos dois ícones por data-fade-x.
 */
import { WORK_TOGGLE } from '../../data/work-page';
---

<div data-cursor="hide" class="work-edge top">
  <div data-work="toggleWrapper" class="toggle-switch-cont">
    <ul data-work="toggle" role="list" class="list w-list-unstyled">
      <li class="work-toggle-w">
        <button data-work="toggle" class="work-toggle inactive" aria-label="Mostrar cartazes">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 50 50" width="100%" data-fade-x="1" class="switch-svg">
            <g fill="currentColor" fill-rule="evenodd" clip-path="url(#clip0_2988_5785)" clip-rule="evenodd">
              <path d="M17.939 13.492v22.687c0 .483.39.873.873.873h12.302c.482 0 .873-.39.873-.873V13.492a.873.873 0 0 0-.873-.873H18.812a.873.873 0 0 0-.873.873Zm-2.62 22.687a3.493 3.493 0 0 0 3.493 3.493h12.302a3.493 3.493 0 0 0 3.492-3.493V13.492a3.493 3.493 0 0 0-3.492-3.493H18.812a3.493 3.493 0 0 0-3.493 3.493v22.687ZM1.62 17.94v13.786c0 .482.39.873.873.873H8.86c.482 0 .873-.39.873-.873V17.941a.873.873 0 0 0-.873-.874H2.493a.873.873 0 0 0-.874.873ZM-1 31.727a3.492 3.492 0 0 0 3.493 3.493H8.86a3.493 3.493 0 0 0 3.493-3.493V17.941a3.493 3.493 0 0 0-3.493-3.493H2.493A3.493 3.493 0 0 0-1 17.94v13.786ZM48.307 17.94v13.786a.873.873 0 0 1-.873.873h-6.367a.873.873 0 0 1-.873-.873V17.941c0-.483.39-.874.873-.874h6.367c.482 0 .873.391.873.873Zm2.62 13.786a3.493 3.493 0 0 1-3.493 3.493h-6.367a3.493 3.493 0 0 1-3.493-3.493V17.941a3.493 3.493 0 0 1 3.493-3.493h6.367a3.493 3.493 0 0 1 3.493 3.492v13.786Z"></path>
            </g>
          </svg>
        </button>
      </li>
      <li class="work-toggle-w">
        <button data-work="toggle" class="work-toggle" aria-label="Mostrar cenas">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 50 50" width="100%" data-fade-x="2" class="switch-svg">
            <path fill="currentColor" fill-rule="evenodd" d="M15.605 29.522v6.986c0 .482.39.873.873.873h6.985c.482 0 .873-.391.873-.873v-6.986a.873.873 0 0 0-.873-.873h-6.985a.873.873 0 0 0-.873.873Zm-2.62 6.986A3.493 3.493 0 0 0 16.478 40h6.985a3.493 3.493 0 0 0 3.492-3.492v-6.986a3.493 3.493 0 0 0-3.492-3.492h-6.985a3.492 3.492 0 0 0-3.493 3.492v6.986ZM33.068 29.522v6.986c0 .482.39.873.873.873h6.985c.482 0 .873-.391.873-.873v-6.986a.873.873 0 0 0-.873-.873H33.94a.873.873 0 0 0-.873.873Zm-2.62 6.986A3.493 3.493 0 0 0 33.941 40h6.985a3.493 3.493 0 0 0 3.492-3.492v-6.986a3.493 3.493 0 0 0-3.492-3.492H33.94a3.493 3.493 0 0 0-3.493 3.492v6.986ZM17.35 12.057v6.986c0 .482-.39.873-.873.873H9.492a.873.873 0 0 1-.873-.873v-6.986c0-.482.39-.873.873-.873h6.985c.482 0 .873.391.873.873Zm2.62 6.986a3.493 3.493 0 0 1-3.493 3.492H9.492A3.493 3.493 0 0 1 6 19.043v-6.986a3.493 3.493 0 0 1 3.492-3.492h6.985a3.492 3.492 0 0 1 3.493 3.492v6.986ZM26.082 12.057v6.986c0 .482.391.873.873.873h6.986a.873.873 0 0 0 .873-.873v-6.986a.873.873 0 0 0-.873-.873h-6.986a.873.873 0 0 0-.873.873Zm-2.62 6.986a3.493 3.493 0 0 0 3.493 3.492h6.986a3.493 3.493 0 0 0 3.492-3.492v-6.986a3.492 3.492 0 0 0-3.492-3.492h-6.986a3.493 3.493 0 0 0-3.492 3.492v6.986Z" clip-rule="evenodd"></path>
          </svg>
        </button>
      </li>
    </ul>
    <div class="abs trig-bg">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 147 68" width="100%">
        <path fill="#222222" d="M146.5 62.058V5.942A5.943 5.943 0 0 1 140.558 0H5.942A5.942 5.942 0 0 1 0 5.942v56.116A5.942 5.942 0 0 1 5.942 68h134.616a5.942 5.942 0 0 1 5.942-5.942Z"></path>
      </svg>
    </div>
    <div class="toggle-switch-w">
      <div class="toggle-switch">
        <div class="switch-bg"></div>
        <div class="div-block-47">
          <div class="switch-alt-tx">
            {WORK_TOGGLE.modes.map((mode) => <div class="swap-tx">{mode}</div>)}
          </div>
          <div class="opacity-30">{WORK_TOGGLE.suffix}</div>
        </div>
      </div>
    </div>
  </div>
</div>
