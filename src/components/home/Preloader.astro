---
/**
 * Abertura da home (div.preloader-w): as barras e o nome em CSS, sem vídeo nenhum (bloco 7 do tema), e os botões ENTRAR
 * que a fecham. O <video> vazio fica porque o app.js lê video.muted ao iniciar: sem o elemento, o runtime inteiro para.
 */
import { PRELOADER } from '../../data/home';
import ExploreButton from '../ui/ExploreButton.astro';
---

<div data-preloader="w" class="preloader-w">
  <video muted="" playsinline="true" class="preloader-video desktop"></video>
  <div class="abertura" aria-hidden="true">
    <div class="ab-carta"></div>
    <div class="ab-comb ab-fora">{Array.from({ length: PRELOADER.barrasFora }, () => <i></i>)}</div>
    <div class="ab-nome"><span>{PRELOADER.nome[0]}</span> <span>{PRELOADER.nome[1]} <span>{PRELOADER.nome[2]}</span></span></div>
  </div>
  <div class="preloader-cont">
    <div data-preloader="btn" class="preloader-btn-w">
      <ExploreButton label={PRELOADER.enterLabel} modifier="desktop" ticket="explore-stroke" />
      <ExploreButton label={PRELOADER.enterLabel} modifier="mobile" arrow="single" ticket="dash" />
    </div>
  </div>
</div>
